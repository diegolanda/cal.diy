# Paste this file into the Railway web service Raw Editor.
# Replace every REPLACE_WITH_* value before you deploy.

# Railway service references
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_DIRECT_URL=${{Postgres.DATABASE_URL}}
DATABASE_HOST=${{Postgres.PGHOST}}:${{Postgres.PGPORT}}
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=600

# Public production URLs and Nuen branding
NEXT_PUBLIC_WEBAPP_URL=https://cal.nuen.io
NEXTAUTH_URL=https://cal.nuen.io
NEXT_PUBLIC_WEBSITE_URL=https://cal.nuen.io
NEXT_PUBLIC_EMBED_LIB_URL=https://cal.nuen.io/embed/embed.js
NEXT_PUBLIC_APP_NAME=Nuen Calendar
NEXT_PUBLIC_COMPANY_NAME=Nuen
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=REPLACE_WITH_MONITORED_SUPPORT_ADDRESS@nuen.io
NEXT_PUBLIC_WEBSITE_PRIVACY_POLICY_URL=https://www.nuen.io/privacy
NEXT_PUBLIC_WEBSITE_TERMS_URL=REPLACE_WITH_NUEN_TERMS_URL
NEXT_PUBLIC_LICENSE_CONSENT=agree
NEXT_PUBLIC_DISABLE_SIGNUP=true
ORGANIZATIONS_ENABLED=false
CALCOM_TELEMETRY_DISABLED=1
CSP_POLICY=non-strict

# Authentication and encryption
NEXTAUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32
CALENDSO_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_24
GOOGLE_LOGIN_ENABLED=true
GOOGLE_API_CREDENTIALS={"web":{"client_id":"REPLACE_WITH_GOOGLE_CLIENT_ID","client_secret":"REPLACE_WITH_GOOGLE_CLIENT_SECRET","redirect_uris":["https://cal.nuen.io/api/integrations/googlecalendar/callback","https://cal.nuen.io/api/auth/callback/google"]}}
GOOGLE_WORKSPACE_AUTH_ENABLED=true
GOOGLE_WORKSPACE_AUTH_DOMAIN=nuen.io
GOOGLE_WORKSPACE_ADMIN_EMAILS=REPLACE_WITH_ADMIN_ADDRESS@nuen.io

# Transactional email
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=REPLACE_WITH_VERIFIED_SENDER@nuen.io
EMAIL_FROM_NAME=Nuen

# Scheduled task authentication
CRON_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
